# Include essential top-level files
include README.md
include LICENSE
include CHANGELOG.md
include pyproject.toml

# Include the PEP 561 typing marker
include case_explainer/py.typed

# Include notebooks
recursive-include notebooks *.ipynb *.md

# Include assets (data files used in examples)
recursive-include assets *.csv *.md

# Include documentation source. Markdown files are listed by name so stray
# notes left in docs/ are never packaged.
recursive-include docs *.rst *.py Makefile
include docs/README.md docs/DEPLOYMENT.md

# Exclude build artifacts and caches
global-exclude __pycache__
global-exclude *.py[cod]
global-exclude *.so
global-exclude .DS_Store
prune dist
prune build
prune *.egg-info
